# Used by docker-compose.yml. Copy to `.env` and adjust for a real deployment;
# the defaults below are fine for local demo use.

POSTGRES_USER=finsight
POSTGRES_PASSWORD=finsight
POSTGRES_DB=finsight

JWT_SECRET=change_me_to_a_long_random_secret

# Baked into the client bundle at build time (the browser calls this
# directly, bypassing the Docker network) — keep it as localhost unless
# you're deploying behind a real domain.
VITE_API_URL=http://localhost:5001/api
